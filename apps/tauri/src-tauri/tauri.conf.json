{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cross the Platforms",
  "version": "0.1.0",
  "identifier": "dev.crosstheplatforms.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Bridge", "width": 1100, "height": 760, "minWidth": 900, "minHeight": 640, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
